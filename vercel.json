{
  "version": 2,
  "builds": [
    { "src": "server/server.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.css", "use": "@vercel/static" },
    { "src": "*.js", "use": "@vercel/static" },
    { "src": "*.json", "use": "@vercel/static" },
    { "src": "*.xml", "use": "@vercel/static" },
    { "src": "*.ico", "use": "@vercel/static" },
    { "src": "*.txt", "use": "@vercel/static" },
    { "src": "images/**", "use": "@vercel/static" },
    { "src": "media/**", "use": "@vercel/static" },
    { "src": "posts/**", "use": "@vercel/static" },
    { "src": "cv/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" },
    { "src": "css/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/tech-blog(\\.html)?", "status": 301, "headers": { "Location": "/blogs.html#tech" } },
    { "src": "/life-blog(\\.html)?", "status": 301, "headers": { "Location": "/blogs.html#life" } },
    { "src": "/rss.xml", "dest": "/rss.xml" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/server/server.js" }
  ]
}